package-as: AzeriteUI5_JuNNeZ_Edition

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# This ignore list is the blacklist mirror of the whitelist in build-release.ps1
# ($ReleaseEntries). Anything not in that whitelist should be ignored here, or the
# CI-published zip carries files the locally built zip does not.
# Whitelist, for reference: Assets, Components, Core, Layouts, Libs, Locale,
# Options, WoW11, the .toc, FontStyles.xml, LICENSE, LICENSE.txt.
# CHANGELOG.md is deliberately not ignored: manual-changelog above consumes it.
ignore:
  # Development files
  - .github
  - .vscode
  - .research
  - .devcontainer
  - .agents
  - .claude
  - .codex
  - .editorconfig
  - .gitignore
  - .gitattributes
  - .luacheckrc
  - .mcp.json

  # Development documentation
  - AGENTS.md
  - FixLog.md
  - FixLog_Archive_*.md
  - CHANGELOG_ARCHIVE.md
  - Docs
  - FEATURE_PLAN.md
  - FIRST_RELEASE_CHECKLIST.md
  - MULTI_PLATFORM_RELEASE.md
  - RELEASE_WORKFLOW.md
  - README.md

  # Retired art, kept on the maintainer's disk only
  - Assets_Moot

  # Wiki sources, published to the GitHub Wiki by sync-wiki.yml, not shipped
  - wiki
  - publish-wiki.sh

  # Build scripts
  - build-release.ps1
  - "*.ps1"

  # IDE files
  - "*.code-workspace"
  - "*.sublime-*"

  # Temporary files
  - "*.bak"
  - "*.tmp"
  - "*.log"

externals:
  Libs/LibStub:
    url: https://repos.curseforge.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0:
    url: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/AceAddon-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceAddon-3.0
  Libs/AceDB-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceDB-3.0
  Libs/AceDBOptions-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceDBOptions-3.0
  Libs/AceEvent-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceEvent-3.0
  Libs/AceTimer-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceTimer-3.0
  Libs/AceConsole-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceConsole-3.0
  Libs/AceHook-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceHook-3.0
  Libs/AceLocale-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceLocale-3.0
  Libs/AceGUI-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceGUI-3.0
  Libs/AceConfig-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceConfig-3.0
  Libs/AceComm-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceComm-3.0
  Libs/AceSerializer-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceSerializer-3.0
  Libs/LibSharedMedia-3.0:
    url: https://repos.curseforge.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  Libs/TaintLess:
